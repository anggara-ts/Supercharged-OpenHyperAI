# Per-game console logs written by tools/split-console.js (big, and they carry the host's Steam ID)
local/match-logs/
# Generated by the Util scripts
local/role-weights/rows.json
local/hero-review/hero-review.html
local/meta-builds/heroes/
# Fretbots / Buff plugin files copied in by the plugin installer (branch plugin-fretbots)
FretBots/
FretBots.lua
Buff/
bots/customize/fretbots.lua
# In-game verification tracker (tools/verify.js): local test state, quotes match-log lines
local/verify/
# Build info for the game's version line (tools/build-info.js, run by the git hooks)
bots/customize/build_info.lua
# Local secrets for the tools/ tools (API tokens). Template: .env.example
.env

# Item-build second opinion (tools/item-builds/check.js): API cache and generated report
local/item-builds/cache/
local/item-builds/report.md
