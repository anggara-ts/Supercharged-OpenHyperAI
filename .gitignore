# Local data of the tools (#221), never committed:
#   match-logs/   per-game console logs from tools/split-console.js (big, and they carry the host's Steam ID)
#   verify/       the in-game verification tracker (tools/verify.js) and test-build.json: local test state that
#                 quotes match-log lines
#   role-weights/rows.json, hero-review/hero-review.html, meta-builds/heroes/: generated reports
#   item-builds/cache/, item-builds/report.md: the Stratz API cache and report of tools/item-builds/check.js
/local/
# The same data at its place before #221, until `node tools/restructure.js --move-local` moves it into local/
# (written [Uu]til so the restructure check does not read it as an old path; git ignores no tracked file)
/[Uu]til/
/[Cc]ustomize/
# Fretbots / Buff plugin files copied in by the plugin installer (branch plugin-fretbots)
FretBots/
FretBots.lua
Buff/
bots/customize/fretbots.lua
# Build info for the game's version line (tools/build-info.js, run by the git hooks)
bots/customize/build_info.lua
# Local secrets for the tools (API tokens). Template: .env.example
.env
# Per-issue checkouts (AGENTS.md). One git worktree per issue: .worktree/oha-issue-<N>
.worktree/
